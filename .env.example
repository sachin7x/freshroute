# FreshRoute Production ENV - Only 5 keys to configure
# Copy to .env and fill

# === 1. PAYMENTS - Razorpay India ===
RAZORPAY_KEY_ID=rzp_test_xxxx
RAZORPAY_KEY_SECRET=xxxx
RAZORPAY_WEBHOOK_SECRET=whsec_xxxx

# === 2. MAPS ===
GOOGLE_MAPS_API_KEY=AIzaSyxxxx
MAPS_PLATFORM=google

# === 3. WHATSAPP ===
WHATSAPP_API_KEY=interakt_xxxx
WHATSAPP_PROVIDER=interakt
WHATSAPP_PHONE_NUMBER_ID=xxxx
WHATSAPP_BUSINESS_ID=xxxx

# === 4. PUSH NOTIFICATIONS ===
FCM_SERVER_KEY=AAAAxxxx
FCM_PROJECT_ID=freshroute-in

# === 5. STORAGE S3 Mumbai ===
AWS_ACCESS_KEY_ID=AKIAxxxx
AWS_SECRET_ACCESS_KEY=xxxx
AWS_REGION=ap-south-1
S3_BUCKET=freshroute-jaipur

# === DB ===
DATABASE_URL=postgresql://freshroute:password@postgres:5432/freshroute
REDIS_URL=redis://redis:6379

# === APP ===
NODE_ENV=production
API_URL=https://api.freshroute.in
WEB_URL=https://freshroute.in
JWT_SECRET=super-secret-jwt-freshroute-2026
JWT_EXPIRES_IN=7d

# === CITIES ===
DEFAULT_CITY=Jaipur
SUPPORTED_CITIES=Jaipur,Kishangarh,Bhilwara
PICKUP_SLOTS=19:00-20:00,20:00-21:00,21:00-22:00
